-- Switch Function
function switch(Txt, trueCode, falseCode)
	local Switch = FB:Clone()

	Switch.TextLabel.Text = "<b>" .. Txt .. "</b>"
	Switch.Position = startPOS + UDim2.new(0, 0, 0, 45)
	Switch.Parent = bgScroll
	startPOS = Switch.Position
	bgScroll.CanvasSize = UDim2.new(0,0,0,startPOS.Y.Offset  + Switch.Size.Y.Offset/2 + 5)
	local button = Switch.TextButton
	local OnSw = false
	
	button.MouseButton1Click:Connect(function()
		OnSw = not OnSw

		if OnSw then
			local CodeError, result = pcall(function() 
				return trueCode() end)
			if CodeError then
				tw:Create(
					button,
					TweenInfo.new(0.3),
					{BackgroundColor3 = Color3.new(0, 1, 0.3)}
				):Play()

				tw:Create(
					button.Frame,
					TweenInfo.new(0.3),
					{Position = UDim2.new(0.40, 0, 0.5, 0)}
				):Play()
			else
				OnSw = false
				task.spawn(function()
					button.BackgroundColor3 = Color3.new(1,0,0.2)
					task.wait(1)
					button.BackgroundColor3 = Color3.new(1,1,1)
				end)
			end

		else
			local codeError, result = pcall(function()
				return falseCode() end)
			if codeError then
				tw:Create(
					button,
					TweenInfo.new(0.3),
					{BackgroundColor3 = Color3.new(1, 1, 1)}
				):Play()

				tw:Create(
					button.Frame,
					TweenInfo.new(0.3),
					{Position = UDim2.new(0.1, 0, 0.5, 0)}
				):Play()
			else
				OnSw = true
				task.spawn(function()
					button.BackgroundColor3 = Color3.new(1,0,0.2)
					task.wait(1)
					button.BackgroundColor3 = Color3.new(1,1,1)
				end)
			end
		end
	end)
end
